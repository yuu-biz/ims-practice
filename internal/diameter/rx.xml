<?xml version="1.0" encoding="UTF-8"?>
<diameter>
    <!--
        What the Rx application of go-diameter leaves out. An AF names a
        UE on IPv6 by Framed-IPv6-Prefix (TS 29.214 V20.0.0 4.4.1,
        Table 5.4.0.1), a NASREQ AVP (RFC 7155 4.4.10.5.6). go-diameter
        defines it only in the NASREQ application and looks AVPs up per
        application, so it is defined here again for Rx. The commands of
        Rx stay those of go-diameter.
    -->
    <application id="16777236" type="auth" name="Rx">
        <vendor id="10415" name="TGPP"/>

        <avp name="Framed-IPv6-Prefix" code="97" must="M" may="-" must-not="V" may-encrypt="Y">
            <data type="OctetString"/>
        </avp>
    </application>
</diameter>
