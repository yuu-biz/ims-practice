# The values of your AKS cluster (kustomization.yaml). Copy this file to
# values.local.env, which Git ignores, and replace the values with those
# of your cluster:
#
#   cp values.local.env.example values.local.env
#
# Every value here is made up and reaches nobody: the addresses are
# documentation ranges (RFC 5737), and names that end in .invalid never
# resolve (RFC 2606). The P-CSCF refuses to start with these addresses.
#
# One KEY=value per line. A line that starts with # is a comment; a #
# after a value is part of the value.

# tofu output -json kubernetes: ims_dns_cluster_ip. Host 53 of
# service_cidr; the default range is kind's, so is the address.
ims_dns_cluster_ip=10.96.0.53

# tofu output -json kubernetes: pod_cidr, the Pod range of Azure CNI
# Overlay. Its default is kind's.
pod_cidr=10.244.0.0/16

# Your line's public address, as the cloud sees it: the address of
# allowed_source_cidrs without its /32. The P-CSCF shows the UE that
# sends from it the relay at edge_public_address (host_access).
ue_public_address=192.0.2.10

# The public address of the edge node, which runs the P-CSCF and the
# media relay: the EXTERNAL-IP that the command of
# "tofu output -raw edge_public_addresses_command" lists, one of
# edge_public_ip_prefix. The UE sends SIP and RTP to it. With the
# component azure-load-balancer-rtp, use the RTP address of
# "tofu output -json load_balancer_public_ips" here.
edge_public_address=203.0.113.20

# What takes the place of "ims-practice" in the image names
# (components/image-registry): your registry and the path you pushed
# ims-practice/ims:dev and ims-practice/capture:dev to. For Azure
# Container Registry it is <registry name>.azurecr.io/ims-practice.
image_prefix=registry.example.invalid/ims-practice

# Only for the load balancer variant (the components
# azure-load-balancer-sip and azure-load-balancer-rtp in
# overlays/cloud-azure): "tofu output -json load_balancer_public_ips"
# gives the name of each static public IP and its resource group. The
# names here are those that deploy/cloud/azure makes with its default
# cluster_name.
load_balancer_resource_group=ims-practice
load_balancer_sip_public_ip=ims-practice-sip
load_balancer_rtp_public_ip=ims-practice-rtp

# The range the load balancer takes SIP and RTP from: your line's /32,
# as in allowed_source_cidrs.
load_balancer_source_range=192.0.2.10/32
