      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(ims_registration_setup_seconds_sum[$__rate_interval])) / sum(rate(ims_registration_setup_seconds_count[$__rate_interval]))",
          "legendFormat": "mean",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ims_registration_setup_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B",
          "range": true
        }
      ]
